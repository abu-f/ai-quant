#!/usr/bin/env bash
# aquant 启动器（WSL）
# 用法：./quant <command> [args]    例如：./quant quote 600519
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="${AQUANT_VENV:-$HOME/.venvs/aquant}"

if [ ! -x "$VENV/bin/python" ]; then
  echo "未找到 Python 虚拟环境：$VENV" >&2
  echo "请先运行：cd $ROOT && ./setup.sh" >&2
  exit 1
fi

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV/bin/python" -m aquant "$@"
